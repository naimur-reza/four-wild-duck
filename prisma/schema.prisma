// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
 

enum MessRole {
  OWNER
  MANAGER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum MonthStatus {
  OPEN
  CLOSED
}

enum ExpenseCategory {
  RENT
  BAZAR
  ELECTRICITY
  GAS
  INTERNET
  OTHER
}

enum CookingStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  SWAPPED
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  username  String?  @unique
  email     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships MessMember[]
}

model Mess {
  id                   String   @id @default(cuid())
  name                 String
  inviteCode           String?  @unique
  createdBy            String
  autoCloseEnabled     Boolean  @default(true)
  closeGracePeriodDays Int      @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members      MessMember[]
  invites      MemberInvite[]
  months       Month[]
  expenses     Expense[]
  cashPayments CashPayment[]
  summaries    MonthlySummary[]
  pushSubscriptions PushSubscription[]
  cookingRoster CookingRoster[]
  cookingDays CookingDay[]
  cookingEntries CookingEntry[]
  cookingUnavailable CookingUnavailable[]
  cookingSummaries CookingMonthlySummary[]
}

model MessMember {
  id             String       @id @default(cuid())
  messId         String
  userId         String
  role           MessRole     @default(MEMBER)
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  mess    Mess    @relation(fields: [messId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  expenses     Expense[]
  cashPayments CashPayment[]
  summaries    MonthlySummary[]
  cookingRoster CookingRoster[]
  cookingEntries CookingEntry[]
  cookingRatings CookingRating[]
  assignedCookingDays CookingDay[] @relation("AssignedCookingDays")
  cookedCookingDays CookingDay[] @relation("CookedCookingDays")
  cookingUnavailable CookingUnavailable[]
  cookingSummaries CookingMonthlySummary[]

  @@unique([messId, userId])
  @@index([userId])
  @@index([messId])
}

model MemberInvite {
  id             String     @id @default(cuid())
  messId         String
  email          String
  role           MessRole   @default(MEMBER)
  openingBalance Decimal    @default(0) @db.Decimal(12, 2)
  invitedBy      String
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, email])
  @@index([email])
  @@index([messId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  messId    String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess Mess @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@index([messId])
  @@index([userId])
}

model Month {
  id          String      @id @default(cuid())
  messId      String
  label       String
  memberCount Int         @default(4)
  status      MonthStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?

  mess         Mess             @relation(fields: [messId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  cashPayments CashPayment[]
  summaries    MonthlySummary[]
  cookingSummaries CookingMonthlySummary[]

  @@index([messId])
}

model Expense {
  id        String          @id @default(cuid())
  messId    String
  monthId   String?
  memberId  String?
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  mess   Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  month  Month?      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  member MessMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([messId])
  @@index([monthId])
  @@index([memberId])
}

model CashPayment {
  id        String   @id @default(cuid())
  messId    String
  monthId   String?
  memberId  String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  month  Month?     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId])
  @@index([monthId])
  @@index([memberId])
}

model MonthlySummary {
  id                String   @id @default(cuid())
  messId            String
  monthId           String
  memberId          String
  previousBalance   Decimal  @default(0) @db.Decimal(12, 2)
  monthlyShare      Decimal  @default(0) @db.Decimal(12, 2)
  expensePaid       Decimal  @default(0) @db.Decimal(12, 2)
  cashPaid          Decimal  @default(0) @db.Decimal(12, 2)
  totalContribution Decimal  @default(0) @db.Decimal(12, 2)
  closingBalance    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  month  Month      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([monthId, memberId])
  @@index([messId])
}

model CookingRoster {
  id        String   @id @default(cuid())
  messId    String
  memberId  String
  position  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messId, memberId])
  @@index([messId, position])
}

model CookingEntry {
  id        String        @id @default(cuid())
  messId    String
  memberId  String
  date      DateTime
  status    CookingStatus @default(COMPLETED)
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  mess    Mess            @relation(fields: [messId], references: [id], onDelete: Cascade)
  member  MessMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ratings CookingRating[]

  @@unique([messId, memberId, date])
  @@index([messId, date])
  @@index([memberId])
}

model CookingRating {
  id        String   @id @default(cuid())
  entryId   String
  memberId  String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry  CookingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  member MessMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([entryId, memberId])
  @@index([memberId])
}

model CookingDay {
  id          String        @id @default(cuid())
  messId      String
  date        DateTime
  assignedToId String?
  cookedById  String?
  status      CookingStatus @default(SCHEDULED)
  comment     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mess       Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  assignedTo MessMember? @relation("AssignedCookingDays", fields: [assignedToId], references: [id], onDelete: SetNull)
  cookedBy   MessMember? @relation("CookedCookingDays", fields: [cookedById], references: [id], onDelete: SetNull)

  @@unique([messId, date])
  @@index([messId])
  @@index([assignedToId])
  @@index([cookedById])
}

model CookingUnavailable {
  id        String   @id @default(cuid())
  messId    String
  memberId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messId, memberId, date])
  @@index([messId, date])
}

model CookingMonthlySummary {
  id        String   @id @default(cuid())
  messId    String
  monthId   String
  memberId  String
  cookedCount Int    @default(0)
  skippedCount Int   @default(0)
  createdAt DateTime @default(now())

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  month  Month      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([monthId, memberId])
  @@index([messId])
}
